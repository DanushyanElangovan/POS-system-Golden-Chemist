<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="stock_valuation" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
<style name="Zebra" mode="Opaque" backcolor="#FFFFFF"><conditionalStyle><conditionExpression><![CDATA[$V{REPORT_COUNT}%2==0]]></conditionExpression><style backcolor="#EEF4F0"/></conditionalStyle></style>
<parameter name="SHOP_NAME" class="java.lang.String"><defaultValueExpression><![CDATA["Golden Chemist Pharmacy"]]></defaultValueExpression></parameter>
<queryString><![CDATA[
SELECT CONCAT(m.brand_name, IFNULL(CONCAT(' ', m.strength), '')) AS medicine, COALESCE(c.name, '-') AS category,
       CAST(SUM(b.quantity) AS SIGNED) AS qty,
       SUM(b.quantity * b.cost_price) AS cost_value,
       SUM(b.quantity * m.selling_price) AS retail_value
FROM medicine m JOIN batch b ON b.medicine_id = m.medicine_id
LEFT JOIN category c ON c.category_id = m.category_id
WHERE b.quantity > 0 AND b.expiry_date >= CURDATE()
GROUP BY m.medicine_id, m.brand_name, m.strength, c.name
ORDER BY medicine]]></queryString>
<field name="medicine" class="java.lang.String"/>
<field name="category" class="java.lang.String"/>
<field name="qty" class="java.lang.Long"/>
<field name="cost_value" class="java.math.BigDecimal"/>
<field name="retail_value" class="java.math.BigDecimal"/>
<variable name="SUM_0" class="java.lang.Long" calculation="Sum"><variableExpression><![CDATA[$F{qty}]]></variableExpression></variable>
<variable name="SUM_1" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{cost_value}]]></variableExpression></variable>
<variable name="SUM_2" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{retail_value}]]></variableExpression></variable>
<title><band height="62">
<rectangle><reportElement x="0" y="0" width="555" height="6" backcolor="#C9A227" forecolor="#C9A227"/></rectangle>
<textField isBlankWhenNull="true"><reportElement x="0" y="10" width="555" height="24" forecolor="#0F5C3A"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="16" isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$P{SHOP_NAME}]]></textFieldExpression></textField>
<staticText><reportElement x="0" y="34" width="555" height="16" forecolor="#222222"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="12" isBold="true"/></textElement><text><![CDATA[Stock Valuation (sellable stock)]]></text></staticText>
</band></title>
