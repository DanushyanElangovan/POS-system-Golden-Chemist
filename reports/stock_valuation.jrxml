<textField pattern="#,##0" isBlankWhenNull="true"><reportElement x="315" y="0" width="60" height="20" style="Zebra" forecolor="#222222"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false"/></textElement><textFieldExpression class="java.lang.Long"><![CDATA[$F{qty}]]></textFieldExpression></textField>
