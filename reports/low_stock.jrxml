<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="low_stock" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
<style name="Zebra" mode="Opaque" backcolor="#FFFFFF"><conditionalStyle><conditionExpression><![CDATA[$V{REPORT_COUNT}%2==0]]></conditionExpression><style backcolor="#EEF4F0"/></conditionalStyle></style>
<parameter name="SHOP_NAME" class="java.lang.String"><defaultValueExpression><![CDATA["Golden Chemist Pharmacy"]]></defaultValueExpression></parameter>
<queryString><![CDATA[
SELECT m.barcode, CONCAT(m.brand_name, IFNULL(CONCAT(' ', m.strength), '')) AS medicine,
       COALESCE(c.name, '-') AS category, m.reorder_level,
       CAST(COALESCE(SUM(b.quantity), 0) AS SIGNED) AS stock
FROM medicine m LEFT JOIN category c ON c.category_id = m.category_id
LEFT JOIN batch b ON b.medicine_id = m.medicine_id AND b.expiry_date >= CURDATE()
WHERE m.active = 1
GROUP BY m.medicine_id, m.barcode, m.brand_name, m.strength, c.name, m.reorder_level
HAVING COALESCE(SUM(b.quantity), 0) <= m.reorder_level
ORDER BY stock, medicine]]></queryString>
<field name="barcode" class="java.lang.String"/>
<field name="medicine" class="java.lang.String"/>
<field name="category" class="java.lang.String"/>
<field name="reorder_level" class="java.lang.Integer"/>
<field name="stock" class="java.lang.Long"/>
<title><band height="62">
<rectangle><reportElement x="0" y="0" width="555" height="6" backcolor="#C9A227" forecolor="#C9A227"/></rectangle>
<textField isBlankWhenNull="true"><reportElement x="0" y="10" width="555" height="24" forecolor="#0F5C3A"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="16" isBold="true"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$P{SHOP_NAME}]]></textFieldExpression></textField>
<staticText><reportElement x="0" y="34" width="555" height="16" forecolor="#222222"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="12" isBold="true"/></textElement><text><![CDATA[Low Stock / Reorder List]]></text></staticText>
</band></title>
<columnHeader><band height="22">
