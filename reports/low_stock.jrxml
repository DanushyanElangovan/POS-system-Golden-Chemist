<textField isBlankWhenNull="true"><reportElement x="105" y="0" width="200" height="20" style="Zebra" forecolor="#222222"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$F{medicine}]]></textFieldExpression></textField>
<textField isBlankWhenNull="true"><reportElement x="305" y="0" width="120" height="20" style="Zebra" forecolor="#222222"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$F{category}]]></textFieldExpression></textField>
<textField pattern="#,##0" isBlankWhenNull="true"><reportElement x="425" y="0" width="65" height="20" style="Zebra" forecolor="#222222"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false"/></textElement><textFieldExpression class="java.lang.Integer"><![CDATA[$F{reorder_level}]]></textFieldExpression></textField>
<textField pattern="#,##0" isBlankWhenNull="true"><reportElement x="490" y="0" width="65" height="20" style="Zebra" forecolor="#222222"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false"/></textElement><textFieldExpression class="java.lang.Long"><![CDATA[$F{stock}]]></textFieldExpression></textField>
